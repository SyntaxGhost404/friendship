<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Window used by NfOverlayWindow (bottom sheets). It spans the whole screen, is fully
        transparent and has no system animation and no system dim: the composable inside
        draws and animates its own scrim, so nothing is scaled or faded by the window manager.
    -->
    <style name="NfOverlayWindow" parent="android:Theme.DeviceDefault.Dialog">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowClipToOutline">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
